program quiz_10;

procedure ganap;
  var
    i : integer;
begin
    if (i mod 2 = 0)then
    begin
        writeln(i)
    else
    begin
        writeln('ini adalah bilangan ganjil');
    end;
        
var
    i :integer;
begin
    writeln('Masukkan nilai 1 :');
    readln(i);
    ganap;
end.

   

